# ==========================================
# TransitOS Environment Configuration
# ==========================================

# PostgreSQL Connection URL
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
#
# 1. Local Docker Setup (matches docker-compose.yml):
DATABASE_URL="postgresql://postgres:1234@localhost:5432/postgres"

# 2. Local Native PostgreSQL / pgAdmin:
# DATABASE_URL="postgresql://postgres:your_password@localhost:5432/transitos"

# 3. Cloud Database (Neon / Supabase / AWS RDS):
# DATABASE_URL="postgresql://user:password@ep-xyz.neon.tech/transitos?sslmode=require"

# Session JWT Authentication Secret (32+ characters)
SESSION_SECRET="dev-session-secret-keys-for-transitos-platform-32-chars"

# Optional Cloud Database Sync Target (used by npm run db:cloud:sync)
# CLOUD_DATABASE_URL="postgresql://user:password@ep-xyz.neon.tech/transitos?sslmode=require"
